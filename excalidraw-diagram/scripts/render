#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat >&2 <<EOF
Usage:
  $(basename "$0") <input.excalidraw|input.md> [output.png] [scale] [max_width]
  $(basename "$0") <input.excalidraw|input.md> <scale> [max_width]
  $(basename "$0") --help

Render Excalidraw JSON or Obsidian Excalidraw Markdown to PNG using agent-browser and the local
HTML renderer template at references/render_template.html.

Arguments:
  input             Source .excalidraw, .excalidraw.md, or .md file.
                    Markdown must contain a Drawing json/compressed-json block.
  output.png        Optional output PNG path.
                    Default: same path as input with .png extension.
                    Omit it when the next argument is a numeric scale.
  scale             Optional device pixel ratio for screenshot output.
                    Default: 2
  max_width         Optional maximum width in CSS pixels, or a preset:
                    720p = 1280, 1080p = 1920, 2k (QHD) = 2560, 4k = 3840.
                    If the rendered diagram is wider, it is scaled down
                    proportionally before capture.
                    PNG pixel dimensions are CSS dimensions multiplied by scale.
                    Presets do not enforce a fixed height or upscale diagrams.
                    Default: 1080p (1920 CSS pixels)

Dependencies:
  agent-browser     Browser automation CLI used for rendering and capture.
  jq                Used to transfer source text and parse SVG dimensions.

Examples:
  $(basename "$0") diagram.excalidraw
  $(basename "$0") diagram.excalidraw diagram.png
  $(basename "$0") diagram.excalidraw diagram.png 2 1920
  $(basename "$0") diagram.excalidraw diagram.png 1 4k
  $(basename "$0") diagram.excalidraw 1 2k
  $(basename "$0") "Zero trust scheme.md" diagram.png

Exit status:
  0  Success
  1  Invalid arguments, missing dependencies, missing files, or render failure
EOF
}

if [ "$#" -eq 1 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; }; then
  usage
  exit 0
fi

if [ "$#" -lt 1 ] || [ "$#" -gt 4 ]; then
  usage
  exit 1
fi

if ! command -v agent-browser >/dev/null 2>&1; then
  printf 'ERROR: agent-browser is not installed\n' >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  printf 'ERROR: jq is not installed\n' >&2
  exit 1
fi

input="$(realpath "$1")"
if [ ! -f "$input" ]; then
  printf 'ERROR: File not found: %s\n' "$1" >&2
  exit 1
fi

case "$input" in
  *.excalidraw|*.md) ;;
  *)
    printf 'ERROR: Input must be an .excalidraw or .md file\n' >&2
    exit 1
    ;;
esac

output="${input%.md}"
output="${output%.excalidraw}.png"
shift

# A numeric second argument is scale, not an output filename.
# Use an explicit path (e.g. ./1) for a purely numeric output filename.
if [ "$#" -gt 0 ] && [[ ! "$1" =~ ^[+-]?[0-9]+([.][0-9]+)?$ ]]; then
  output="$(realpath -m "$1")"
  shift
fi
if [ "$#" -gt 2 ]; then
  printf 'ERROR: Too many arguments after input/output; expected scale and max_width\n' >&2
  exit 1
fi

scale="${1:-2}"
max_width="${2:-1080p}"
if [[ ! "$scale" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
  ! jq -en --arg scale "$scale" '$scale | tonumber > 0' >/dev/null 2>&1; then
  printf 'ERROR: scale must be a positive number (for example: 1, 1.5, 2)\n' >&2
  exit 1
fi
case "${max_width,,}" in
  720p) max_width=1280 ;;
  1080p) max_width=1920 ;;
  2k) max_width=2560 ;;
  4k) max_width=3840 ;;
  *)
    if [[ ! "$max_width" =~ ^[1-9][0-9]*$ ]]; then
      printf 'ERROR: max_width must be a positive integer or one of: 720p, 1080p, 2k, 4k\n' >&2
      exit 1
    fi
    ;;
esac
template="$(realpath "$(dirname "$0")/../references/render_template.html")"

if [ ! -f "$template" ]; then
  printf 'ERROR: Template not found: %s\n' "$template" >&2
  exit 1
fi

session="excalidraw-render-$$"
dims="/tmp/${session}.json"

cleanup() {
  agent-browser --session "$session" close >/dev/null 2>&1 || true
  rm -f "$dims"
}

trap cleanup EXIT

agent-browser --session "$session" open "file://$template"
agent-browser --session "$session" wait --fn "window.__moduleReady === true"
# Transfer raw text via stdin: Chromium may download Markdown instead of displaying it.
# JSON quoting also keeps source content out of executable JavaScript.
jq -Rrs '"(async () => { const result = await window.renderDiagram(" + tojson + "); if (!result.success) throw new Error(result.error); return true; })()"' "$input" |
  agent-browser --session "$session" eval --stdin >/dev/null
agent-browser --session "$session" wait --fn "window.__renderComplete === true"
agent-browser --session "$session" eval '(() => { const svg = document.querySelector("#root svg"); if (!svg) throw new Error("No SVG after render"); const rect = svg.getBoundingClientRect(); return { width: Math.ceil(rect.width), height: Math.ceil(rect.height) }; })()' > "$dims"

width="$(jq -r '.width' "$dims")"
height="$(jq -r '.height' "$dims")"
ratio="$(jq -n --argjson w "$width" --argjson m "$max_width" 'if $w > $m then ($m / $w) else 1 end')"
target_width="$(jq -n --argjson w "$width" --argjson r "$ratio" '($w * $r | ceil)')"
target_height="$(jq -n --argjson h "$height" --argjson r "$ratio" '($h * $r | ceil)')"

agent-browser --session "$session" eval "(() => { const root = document.getElementById('root'); root.style.transform = 'scale($ratio)'; root.style.transformOrigin = 'top left'; document.body.style.width = '${target_width}px'; document.body.style.height = '${target_height}px'; return true; })()" >/dev/null
agent-browser --session "$session" set viewport "$target_width" "$target_height" "$scale"
agent-browser --session "$session" screenshot "$output"

printf '%s\n' "$output"
